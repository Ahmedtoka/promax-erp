<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>

    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>

        <!--
          ⚠️ MySQL مش SQLite.

          المايجريشنز بتاعتنا فيها `ALTER TABLE ... MODIFY` و
          `Schema::getIndexes()` و `AUTO_INCREMENT` — كلها MySQL خالص
          وSQLite بترمي عليها أخطاء. تيست على محرك مختلف عن الإنتاج
          بيمرّ وبيسيب باجات المحرك الحقيقي تعدي.

          محتاج تعمل الداتابيز دي مرة واحدة:
              CREATE DATABASE promax_test;
        -->
        <env name="DB_CONNECTION" value="mysql"/>
        <!-- ⚠️ السيرفر واليوزر متثبتين هنا مش من .env (٢٦/٩): .env اللوكال
             اتبدّل مرة بنسخة اللايف، والتيست راح يعمل RefreshDatabase على
             سيرفر اللايف. التيستات على MySQL المحلي وبس. -->
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_PORT" value="3306" force="true"/>
        <env name="DB_USERNAME" value="root" force="true"/>
        <env name="DB_PASSWORD" value="" force="true"/>
        <env name="DB_DATABASE" value="promax_test" force="true"/>

        <!-- الإنجليزي هو الافتراضي، والتيست بيتأكد من اللغتين -->
        <env name="APP_LOCALE" value="en"/>
    </php>
</phpunit>
